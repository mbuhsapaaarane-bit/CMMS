@echo off\r\ntitle CMMS - Auto Installer Lokal\r\ncd /d "%~dp0"\r\nsetlocal\r\n\r\necho ==========================================================\r\necho   CMMS - Auto Installer Lokal (Windows)\r\necho   Laravel 10 + SQLite\r\necho ==========================================================\r\necho.\r\n\r\nREM ---------- 1. Cek prasyarat ----------\r\necho [1/5] Memeriksa prasyarat...\r\n\r\nwhere php >nul 2>nul\r\nif errorlevel 1 (\r\n    echo.\r\n    echo [GAGAL] PHP tidak ditemukan di PATH.\r\n    echo         Install PHP 8.1+ lalu tambahkan ke PATH:\r\n    echo         https://windows.php.net/download/\r\n    echo.\r\n    pause\r\n    exit /b 1\r\n)\r\nfor /f "delims=" %%v in ('php -r "echo PHP_VERSION;"') do set PHPVER=%%v\r\necho         PHP %PHPVER% ditemukan.\r\n\r\nwhere composer >nul 2>nul\r\nif errorlevel 1 (\r\n    echo.\r\n    echo [GAGAL] Composer tidak ditemukan di PATH.\r\n    echo         Install dari: https://getcomposer.org/download/\r\n    echo.\r\n    pause\r\n    exit /b 1\r\n)\r\necho         Composer ditemukan.\r\n\r\nREM ---------- 2. Install dependency ----------\r\necho.\r\necho [2/5] Menginstall dependency (composer install)...\r\nif exist vendor\autoload.php (\r\n    echo         vendor/ sudah ada, dilewati.\r\n) else (\r\n    call composer install --no-interaction\r\n    if errorlevel 1 (\r\n        echo.\r\n        echo [GAGAL] composer install gagal. Periksa pesan di atas.\r\n        echo.\r\n        pause\r\n        exit /b 1\r\n    )\r\n)\r\n\r\nREM ---------- 3. Buat .env ----------\r\necho.\r\necho [3/5] Menyiapkan file .env...\r\nif not exist .env (\r\n    if exist .env_sqlite (\r\n        copy /Y .env_sqlite .env >nul\r\n        echo         .env dibuat dari .env_sqlite (SQLite).\r\n    ) else (\r\n        echo.\r\n        echo [GAGAL] .env_sqlite tidak ditemukan.\r\n        echo.\r\n        pause\r\n        exit /b 1\r\n    )\r\n    php artisan key:generate --force\r\n) else (\r\n    echo         .env sudah ada, dilewati (tidak menimpa konfigurasi Anda).\r\n)\r\nphp artisan config:clear >nul 2>nul\r\n\r\nREM ---------- 4. Database ----------\r\necho.\r\necho [4/5] Menyiapkan database...\r\nif not exist database\database.sqlite (\r\n    type nul > database\database.sqlite\r\n    echo         database.sqlite dibuat.\r\n)\r\nphp artisan migrate --seed --force\r\nif errorlevel 1 (\r\n    echo.\r\n    echo [GAGAL] Migrasi gagal. Periksa pesan di atas.\r\n    echo.\r\n    pause\r\n    exit /b 1\r\n)\r\necho         Migrasi + seed selesai.\r\n\r\nREM ---------- 5. Jalankan server ----------\r\necho.\r\necho [5/5] Menjalankan server...\r\necho.\r\necho   Buka di browser : http://127.0.0.1:8000\r\necho   Akun demo       : ahmad / manager1   (Manager)\r\necho                     budi / leader1     (Leader)\r\necho                     cahyo / op1        (Operator)\r\necho.\r\necho   Jika port 8000 sibuk, jalankan:  php artisan serve --port=8080\r\necho   Tekan Ctrl+C untuk menghentikan server.\r\necho ==========================================================\r\nphp artisan serve\r\n\r\necho.\r\npause\r\n