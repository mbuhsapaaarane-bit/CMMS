# ============================================
# CMMS - Template .env (default: SQLite + file session)
# Bandingkan baris-baris ini dengan isi .env kamu.
# JANGAN ada spasi di sekitar "=" ->  SESSION_DRIVER=file  (bukan SESSION_DRIVER = file)
# JANGAN pakai tanda kutip ->  APP_NAME=CMMS  (bukan APP_NAME="CMMS")
# ============================================

APP_NAME=CMMS
APP_ENV=local
# APP_KEY diisi otomatis oleh:  php artisan key:generate
APP_KEY=base64:mEwSL6+KMEvVqBX2pff5OICUlaoI+AUGg0/rMalZWF4=
APP_DEBUG=true
APP_URL=http://localhost

# ---------- SESSION (PENTING UNTUK ERROR LOGIN) ----------
# Pilihan driver: file | database | cookie | array | redis | memcached
# Untuk app ini cukup "file" (disimpan di storage/framework/sessions).
# JANGAN pakai "database" kecuali tabel "sessions" sudah dibuat via:
#   php artisan session:table  &&  php artisan migrate
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=cmms_session

# ---------- DATABASE (default: MySQL Laragon) ----------
# 1. Buat database "cmms" dulu di HeidiSQL (Laragon -> HeidiSQL -> root, tanpa password)
# 2. Ubah 5 baris berikut, lalu jalankan:  php artisan migrate --seed
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmms
DB_USERNAME=root
DB_PASSWORD=root

# Alternatif: kembali ke SQLite = hapus 6 baris konfigurasi DB di atas, lalu aktifkan:
# DB_CONNECTION=sqlite

# ---------- CACHE / QUEUE (default aman) ----------
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ---------- LOG ----------
LOG_CHANNEL=stack
LOG_LEVEL=debug