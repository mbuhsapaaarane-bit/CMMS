# =====================================================================
# Template konfigurasi untuk DEPLOY (VPS / shared hosting).
# Untuk instalasi LOKAL, cukup salin .env_sqlite menjadi .env.
# =====================================================================

APP_NAME=CMMS
APP_ENV=production
# WAJIB diisi: hasil dari `php artisan key:generate` (format base64:...)
APP_KEY=
APP_DEBUG=false
# Ganti dengan domain aplikasi, contoh: https://cmms.example.com
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================================
# DATABASE — pilih salah satu:
#
# Opsi A) SQLite (hanya untuk uji coba lokal):
#   DB_CONNECTION=sqlite
#   (file default database/database.sqlite — jangan set DB_DATABASE)
#
# Opsi B) MySQL (VPS / shared hosting):
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=cmms
#   DB_USERNAME=cmms_user
#   DB_PASSWORD=ganti-password
# =====================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmms
DB_USERNAME=cmms_user
DB_PASSWORD=ganti-password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Isi true HANYA jika akses sudah lewat HTTPS. Biarkan kosong untuk HTTP.
SESSION_SECURE_COOKIE=

# Token sekali pakai untuk migrasi via web (hosting tanpa SSH).
# Isi string acak, buka https://domain-anda/setup?token=ISI_TOKEN,
# lalu KOSONGKAN kembali token ini setelah migrasi selesai.
SETUP_TOKEN=
