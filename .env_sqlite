# =====================================================================
# Konfigurasi INSTALASI LOKAL (SQLite) — paling cepat.
# Cara pakai: salin file ini menjadi .env, lalu jalankan:
#   composer install
#   php artisan key:generate
#   php artisan migrate --seed
#   php artisan serve
# =====================================================================

APP_NAME=CMMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite lokal. Tanpa baris DB_DATABASE agar memakai default
# database/database.sqlite (portabel lintas OS).
DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
