# Normalisasi line ending agar diff GitHub bersih
* text=auto

# Kode & dokumen: pakai LF (standar GitHub)
*.php text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.xml text eol=lf

# File Windows batch: wajib CRLF agar cmd.exe tidak salah parse
*.bat text eol=crlf

# File biner jangan diubah
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.sqlite binary
*.db binary
